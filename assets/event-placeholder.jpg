<svg viewBox="0 0 640 800" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="eventGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#16A34A;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#0B6B35;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#050806;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <rect width="640" height="800" fill="url(#eventGrad)"/>
  
  <!-- Grid pattern -->
  <g stroke="rgba(57, 255, 136, 0.1)" stroke-width="2">
    <line x1="0" y1="0" x2="640" y2="0"/>
    <line x1="0" y1="50" x2="640" y2="50"/>
    <line x1="0" y1="100" x2="640" y2="100"/>
    <line x1="0" y1="150" x2="640" y2="150"/>
    <line x1="0" y1="200" x2="640" y2="200"/>
    <line x1="0" y1="250" x2="640" y2="250"/>
    <line x1="0" y1="300" x2="640" y2="300"/>
    <line x1="0" y1="350" x2="640" y2="350"/>
    <line x1="0" y1="400" x2="640" y2="400"/>
    <line x1="0" y1="450" x2="640" y2="450"/>
    <line x1="0" y1="500" x2="640" y2="500"/>
    <line x1="0" y1="550" x2="640" y2="550"/>
    <line x1="0" y1="600" x2="640" y2="600"/>
    <line x1="0" y1="650" x2="640" y2="650"/>
    <line x1="0" y1="700" x2="640" y2="700"/>
    <line x1="0" y1="750" x2="640" y2="750"/>
    <line x1="0" y1="800" x2="640" y2="800"/>
    
    <line x1="0" y1="0" x2="0" y2="800"/>
    <line x1="50" y1="0" x2="50" y2="800"/>
    <line x1="100" y1="0" x2="100" y2="800"/>
    <line x1="150" y1="0" x2="150" y2="800"/>
    <line x1="200" y1="0" x2="200" y2="800"/>
    <line x1="250" y1="0" x2="250" y2="800"/>
    <line x1="300" y1="0" x2="300" y2="800"/>
    <line x1="350" y1="0" x2="350" y2="800"/>
    <line x1="400" y1="0" x2="400" y2="800"/>
    <line x1="450" y1="0" x2="450" y2="800"/>
    <line x1="500" y1="0" x2="500" y2="800"/>
    <line x1="550" y1="0" x2="550" y2="800"/>
    <line x1="600" y1="0" x2="600" y2="800"/>
  </g>
  
  <!-- Event elements -->
  <g fill="rgba(57, 255, 136, 0.3)">
    <circle cx="160" cy="150" r="60"/>
    <circle cx="480" cy="200" r="80"/>
    <circle cx="320" cy="450" r="100"/>
    <circle cx="100" cy="650" r="50"/>
    <circle cx="540" cy="700" r="70"/>
  </g>
  
  <!-- Text placeholder -->
  <text x="320" y="400" font-family="JetBrains Mono" font-size="32" fill="rgba(57, 255, 136, 0.5)" text-anchor="middle" opacity="0.6">
    [EVENT]
  </text>
</svg>
