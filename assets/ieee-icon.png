<svg viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="ieeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#39FF88;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16A34A;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Rounded square background -->
  <rect width="192" height="192" rx="48" fill="#050806"/>
  <rect x="8" y="8" width="176" height="176" rx="40" fill="none" stroke="url(#ieeGrad)" stroke-width="2"/>
  
  <!-- IEEE text or symbol -->
  <text x="96" y="120" font-family="JetBrains Mono" font-size="64" font-weight="bold" fill="url(#ieeGrad)" text-anchor="middle">
    IEEE
  </text>
  
  <!-- Decorative dots -->
  <circle cx="40" cy="40" r="3" fill="url(#ieeGrad)"/>
  <circle cx="152" cy="40" r="3" fill="url(#ieeGrad)"/>
  <circle cx="40" cy="152" r="3" fill="url(#ieeGrad)"/>
  <circle cx="152" cy="152" r="3" fill="url(#ieeGrad)"/>
</svg>
